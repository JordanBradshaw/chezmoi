-- ~/.wezterm.lua
local wezterm = require("wezterm")
local config = {}
-- For newer WezTerm versions:
if wezterm.config_builder then
  config = wezterm.config_builder()
end
-- ---------- GENERAL ----------
config.check_for_updates = false
config.adjust_window_size_when_changing_font_size = false
config.hide_tab_bar_if_only_one_tab = true
config.use_fancy_tab_bar = true
config.window_decorations = "RESIZE"
config.scrollback_lines = 5000
-- ---------- FONT / APPEARANCE ----------
config.font = wezterm.font_with_fallback({
  "JetBrainsMono Nerd Font",
  "FiraCode Nerd Font",
})
config.font_size = 11.0
-- You can change this to your taste
config.color_scheme = "Tokyo Night"
-- ---------- PLATFORM / WSL HANDLING ----------
-- If you're on Windows + WSL, set your default domain to your distro:
-- Run `wezterm ls` to list domains and use that name here.
-- Example: "WSL:Ubuntu-24.04" or "WSL:Ubuntu"
-- Comment this out if you're not using WSL.
config.default_domain = "WSL:Ubuntu-24.04"  -- <-- change this to your actual WSL distro
-- Start zsh inside WSL if available
config.default_prog = { "zsh", "-l" }
-- ---------- KEYBINDINGS ----------
config.leader = { key = "Space", mods = "CTRL", timeout_milliseconds = 1000 }
config.keys = {
  -- New tab
  {
    key = "c",
    mods = "LEADER",
    action = wezterm.action.SpawnTab("CurrentPaneDomain"),
  },
  -- Close tab
  {
    key = "x",
    mods = "LEADER",
    action = wezterm.action.CloseCurrentTab({ confirm = true }),
  },
  -- Split pane horizontally / vertically (WezTerm-level)
  {
    key = "-",
    mods = "LEADER",
    action = wezterm.action.SplitHorizontal({ domain = "CurrentPaneDomain" }),
  },
  {
    key = "\\",
    mods = "LEADER",
    action = wezterm.action.SplitVertical({ domain = "CurrentPaneDomain" }),
  },
  -- Navigate panes (WezTerm-level)
  {
    key = "h",
    mods = "LEADER",
    action = wezterm.action.ActivatePaneDirection("Left"),
  },
  {
    key = "j",
    mods = "LEADER",
    action = wezterm.action.ActivatePaneDirection("Down"),
  },
  {
    key = "k",
    mods = "LEADER",
    action = wezterm.action.ActivatePaneDirection("Up"),
  },
  {
    key = "l",
    mods = "LEADER",
    action = wezterm.action.ActivatePaneDirection("Right"),
  },
  -- Send tmux prefix (C-Space) into the shell (if tmux is running)
  {
    key = "Space",
    mods = "ALT",
    action = wezterm.action.SendKey({ key = "Space", mods = "CTRL" }),
  },
  -- Reload wezterm config
  {
    key = "r",
    mods = "LEADER",
    action = wezterm.action.ReloadConfiguration,
  },
}
-- ---------- MISC ----------
config.audible_bell = "Disabled"

[".config/zsh/.antidote"]
    type = "git-repo"
    url = "https://github.com/mattmc3/antidote.git"
    refreshPeriod = "168h"
    [".config/zsh/.antidote".clone]
        args = ["--depth", "1"]
    [".config/zsh/.antidote".pull]
        args = ["--ff-only"]

# yupps-zsh (personal plugin and theme) isn't an external: zshrc.d/71-custom-plugin.zsh
# clones it to plugins/yupps-zsh, and an exact external there would wipe the
# clone's .git.

{{- /* tmux plugins, loaded in order by ~/.config/tmux/load-plugins.sh (no
       TPM). Archives rather than git clones so `chezmoi archive` can bundle
       them for zssh. */ -}}
{{- $tmuxPlugins := dict
      "tmux-sensible"         "tmux-plugins/tmux-sensible/archive/refs/heads/master"
      "catppuccin"            "catppuccin/tmux/archive/refs/tags/v2.3.2"
      "tmux-prefix-highlight" "tmux-plugins/tmux-prefix-highlight/archive/refs/heads/master"
      "tmux-yank"             "tmux-plugins/tmux-yank/archive/refs/tags/v2.3.0"
      "tmux-logging"          "tmux-plugins/tmux-logging/archive/refs/heads/master"
      "extrakto"              "laktak/extrakto/archive/refs/heads/master"
      "tmux-resurrect"        "tmux-plugins/tmux-resurrect/archive/refs/heads/master"
      "tmux-continuum"        "tmux-plugins/tmux-continuum/archive/refs/heads/master" }}
{{- range $name, $path := $tmuxPlugins }}

[".config/tmux/plugins/{{ $name }}"]
    type = "archive"
    url = "https://github.com/{{ $path }}.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"
{{- end }}
{{- if eq .machine "desktop" }}

# Fira Code with Nerd Font icons (eza/lsd, catppuccin tmux), used by the
# yupps Konsole/Yakuake profile. Over zssh the remote side can't supply it:
# the local terminal draws the glyphs.
[".local/share/fonts/FiraCodeNerdFont"]
    type = "archive"
    url = "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/FiraCode.tar.xz"
    exact = true
    include = ["*.ttf"]
    refreshPeriod = "168h"

[".local/share/icons/candy-icons"]
    type = "git-repo"
    url = "https://github.com/EliverLara/candy-icons.git"
    refreshPeriod = "168h"
    [".local/share/icons/candy-icons".clone]
        args = ["--depth", "1"]
    [".local/share/icons/candy-icons".pull]
        args = ["--ff-only"]

[".local/share/icons"]
    type = "archive"
    url = "https://github.com/EliverLara/Sweet-folders/archive/refs/heads/master.tar.gz"
    exact = false
    stripComponents = 1
    include = ["*/Sweet-*", "*/Sweet-*/**"]
    refreshPeriod = "168h"
{{- end }}

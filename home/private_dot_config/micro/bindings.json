{
    // ===== Core VS Code–like stuff =====
    "Ctrl-s": "Save",
    "Ctrl-x": "Close",
    "Ctrl-f": "Find",
    "Ctrl-h": "Replace",
    "Ctrl-g": "command-edit:goto ",
    // For comments you need the "comment" plugin:
    // > plugin install comment
    "Ctrl-/": "command:comment.toggle",
    // ===== Splits that won't fight VS Code =====
    // Use Alt-based keys so VS Code mostly ignores them in the terminal
    "Alt--": "HSplit", // horizontal split
    "Alt-|": "VSplit", // vertical split
    "Alt-h": "Select-Left",
    "Alt-l": "Select-Right",
    "Alt-j": "Select-Down",
    "Alt-k": "Select-Up",
    // ===== Tabs =====
    "Ctrl-Tab": "NextTab",
    "Ctrl-Shift-Tab": "PreviousTab"
}

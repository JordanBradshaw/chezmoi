[core]
#    editor = nano
    autocrlf = input
    safecrlf = true
    filemode = true
    excludesfile = ~/.config/git/ignore
    pager = delta
    fsmonitor = true
[apply]
    whitespace = fix
[color]
    ui = auto
[color "status"]
    added = green
    changed = yellow
    untracked = red
[color "diff"]
    old = red
    new = green
[pull]
    ff = only
    rebase = true
[push]
    default = simple
    autoSetupRemote = true
[branch]
    sort = -committerdate
[status]
    short = true
    branch = true
    showStash = true
[fetch]
    prune = true
    recurseSubmodules = on-demand
[merge]
    conflictstyle = zdiff3
    stat = true
    ff = only
[diff]
    algorithm = patience
    renames = true
    mnemonicprefix = true
    colorMoved = default
    tool = delta
[rerere]
    enabled = true
[rebase]
    autoStash = true
[pager]
    log = delta
    diff = delta
    show = delta
    blame = delta
[delta]
    features = line-numbers decorations
    line-numbers = true
    navigate = true
    syntax-theme = Dracula
    side-by-side = true
[delta "decorations"]
    commit-decoration-style = bold yellow box
    file-style = bold cyan
    file-decoration-style = none
[interactive]
    diffFilter = delta --color-only
[alias]
    st = status -sb
    co = checkout
    br = branch
    ci = commit
    df = diff
    lg = log --graph --decorate --all --pretty=format:'%C(yellow)%h%Creset %Cgreen%ad%Creset %C(cyan)%an%Creset %C(auto)%d%Creset %s'
    lga = !git lg --all
    fix = commit --amend --no-edit
    undo = reset HEAD~1
    unstage = reset HEAD --
    amend = commit --amend --no-edit
    last = log -1 HEAD
[commit]
    gpgSign = false

[tag]
    gpgSign = false

[include] 
    path = ~/.config/git/config.local

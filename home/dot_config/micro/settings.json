{
    "colorscheme": "gruvbox", // great dark theme for coding
    "truecolor": true, // tmux needs this for correct colors
    "tabsize": 4,
    "autoindent": true,
    "smartindent": true,
    "ruler": true,
    "cursorline": true,
    "statusline": true,
    "softwrap": false, // programmers usually prefer no wrapping
    "wordwrap": false,
    "lint": true, // needed for Rust/C++ LSP diagnostics
    "lsp": true, // enable language server client
    "clipboard": "external", // better copy/paste inside tmux
    "savecursor": true,
    "mouse": true, // works inside tmux if enabled there
    "mkparents": true
}

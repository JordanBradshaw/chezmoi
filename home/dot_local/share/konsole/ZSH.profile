[Appearance]
AntiAliasFonts=true
BoldIntense=true
ColorScheme=Sweet-Ambar-Blue
Font=Fira Code Retina,10,-1,5,53,0,0,0,0,0,Regular
WordMode=true

[Cursor Options]
CursorShape=1

[General]
Command=/bin/zsh
Icon=yakuake-symbolic
LocalTabTitleFormat=%h: %d
Name=ZSH
Parent=FALLBACK/
RemoteTabTitleFormat=%u@%h
SemanticUpDown=true

[Interaction Options]
MouseWheelZoomEnabled=false

[Keyboard]
KeyBindings=default

[Scrolling]
HighlightScrolledLines=true
HistoryMode=1
HistorySize=2000
ReflowLines=true

[Terminal Features]
AnimatingCursorEnabled=false
BellMode=3
BlinkingCursorEnabled=false

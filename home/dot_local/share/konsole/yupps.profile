[Appearance]
AntiAliasFonts=true
BoldIntense=true
ColorScheme=Sweet-Ambar-Blue
Font=FiraCode Nerd Font,10,-1,5,50,0,0,0,0,0,Regular
WordMode=true

[Cursor Options]
CursorShape=1

[General]
Command=/bin/zsh
Icon=nitrogen
LocalTabTitleFormat=%h: %d
Name=yupps
Parent=FALLBACK/
RemoteTabTitleFormat=%u@%h
SemanticUpDown=true

[Interaction Options]
MouseWheelZoomEnabled=false
TrimTrailingSpacesInSelectedText=true

[Keyboard]
KeyBindings=default

[Scrolling]
HighlightScrolledLines=true
HistoryMode=2
HistorySize=2000
ReflowLines=true

[Terminal Features]
AnimatingCursorEnabled=false
BellMode=3
BlinkingCursorEnabled=false

#!/usr/bin/env bash
#
# zssh: ssh into a host with this machine's zsh setup, without installing
# anything there or needing internet on it.
#
# Usage: zssh [--rebuild] [--refresh] [ssh options] host
#
#   Builds (or reuses) a bundle for the host's CPU with
#   portable/build.sh from a chezmoi-deploy checkout, uploads it over ssh only when it changed, and
#   starts the bundled zsh. Everything lives in /tmp/.zsh-portable on the
#   host; delete that directory to remove it. No secrets are ever bundled.
#
#   --rebuild   rebuild the bundle even if the dotfiles didn't change
#   --refresh   also re-download zsh, tools and plugins
#
# Environment:
#   ZSSH_REMOTE_DIR  bundle dir on the host (default: /tmp/.zsh-portable,
#                    expanded by the remote shell)
#   ZSSH_DEPLOY      chezmoi-deploy checkout (default: chezmoi-deploy next to
#                    the chezmoi checkout, else the chezmoi external in
#                    ${XDG_DATA_HOME:-$HOME/.local/share}/chezmoi-deploy,
#                    which zssh pulls when it wasn't fetched for a day)
#   ZSSH_BUILDER     build script (default: $ZSSH_DEPLOY/portable/build.sh)
#   CHEZMOI_SRC      chezmoi checkout (default: git root of chezmoi source-path)

set -euo pipefail

usage() {
    sed -n '3,22p' "$0" | sed 's/^# \{0,1\}//'
}

build_flags=()
while (( $# )); do
    case $1 in
        --rebuild) build_flags=(--force); shift ;;
        --refresh) build_flags=(--refresh); shift ;;
        -h | --help) usage; exit 0 ;;
        *) break ;;
    esac
done
if (( $# == 0 )); then
    usage >&2
    exit 2
fi

remote_dir=${ZSSH_REMOTE_DIR:-'/tmp/.zsh-portable'}

# Icons (eza, lsd, tmux status) are drawn by the local terminal's font; the
# host can't supply one. chezmoi installs FiraCode Nerd Font on desktops.
# The list is read whole: grep -q would kill fc-list early, and pipefail
# would count that as no match.
if command -v fc-list >/dev/null 2>&1 \
    && ! grep -qi 'Nerd Font' <<<"$(fc-list : family 2>/dev/null)"; then
    echo "zssh: no Nerd Font installed locally, icons will show as boxes" >&2
fi

if [[ -z ${CHEZMOI_SRC:-} ]]; then
    sp="$(chezmoi source-path 2>/dev/null)" || sp=""
    if [[ -n $sp ]] && CHEZMOI_SRC="$(git -C "$sp" rev-parse --show-toplevel 2>/dev/null)" && [[ -n $CHEZMOI_SRC ]]; then
        :
    else
        unset CHEZMOI_SRC
    fi
fi

# update_external DIR: chezmoi pulls its chezmoi-deploy external only weekly,
# so pull it here when it wasn't fetched for a day. A failed pull (offline)
# warns and builds with what is there.
update_external() {
    local dir=$1 stamp=$1/.git/FETCH_HEAD
    [[ -d $dir/.git ]] || return 0
    [[ -e $stamp ]] || stamp=$dir/.git/HEAD
    [[ -n $(find "$stamp" -mmin +1440 2>/dev/null) ]] || return 0
    if ! timeout 30 git -C "$dir" pull --quiet --ff-only </dev/null >/dev/null 2>&1; then
        echo "zssh: could not update $dir, building with it as is" >&2
    fi
}

builder=${ZSSH_BUILDER:-}
if [[ -z $builder ]]; then
    external="${XDG_DATA_HOME:-$HOME/.local/share}/chezmoi-deploy"
    for dir in "${ZSSH_DEPLOY:-}" "${CHEZMOI_SRC:+$(dirname "$CHEZMOI_SRC")/chezmoi-deploy}" "$external"; do
        if [[ -n $dir && -x $dir/portable/build.sh ]]; then
            [[ $dir != "$external" ]] || update_external "$dir"
            builder="$dir/portable/build.sh"
            break
        fi
    done
    if [[ -z $builder ]]; then
        echo "zssh: no chezmoi-deploy checkout; set ZSSH_DEPLOY or run chezmoi apply on a desktop" >&2
        exit 1
    fi
    if [[ -z ${CHEZMOI_SRC:-} ]]; then
        echo "zssh: set CHEZMOI_SRC to your chezmoi checkout" >&2
        exit 1
    fi
fi
[[ -z ${CHEZMOI_SRC:-} ]] || export CHEZMOI_SRC

# Reuse one connection for the probe, the upload and the session.
ssh_opts=(
    -o ControlMaster=auto
    -o "ControlPath=${XDG_RUNTIME_DIR:-/tmp}/zssh-%C"
    -o ControlPersist=60
)

# -n: the probe must not eat keystrokes meant for the session.
probe="$(ssh -n "${ssh_opts[@]}" "$@" "uname -m
cat \"$remote_dir/app/VERSION\" 2>/dev/null || echo
command -v tar >/dev/null 2>&1 && echo tar || echo
command -v gzip >/dev/null 2>&1 && echo gzip || echo")"
remote_arch=$(sed -n 1p <<<"$probe")
remote_version=$(sed -n 2p <<<"$probe")
remote_tar=$(sed -n 3p <<<"$probe")
remote_gzip=$(sed -n 4p <<<"$probe")

bundle="$("$builder" --arch "$remote_arch" "${build_flags[@]}" | tail -n1)"
local_version=$(<"${bundle%.tar.gz}.version")

if [[ $local_version != "$remote_version" ]]; then
    if [[ -z $remote_tar ]]; then
        echo "zssh: the host has no tar; zssh needs tar to unpack the bundle" >&2
        exit 1
    fi
    # Minimal images (busybox, Yocto) may lack gzip: unpack locally instead.
    # -o: files belong to the user unpacking them, never the archive's uid.
    unpack="tar -xozf -"
    send=(cat "$bundle")
    if [[ -z $remote_gzip ]]; then
        echo "zssh: host has no gzip, sending uncompressed" >&2
        unpack="tar -xof -"
        send=(gzip -dc "$bundle")
    fi
    echo "zssh: uploading bundle $local_version ($(du -h "$bundle" | cut -f1))" >&2
    "${send[@]}" | ssh "${ssh_opts[@]}" "$@" "set -e
d=\"$remote_dir\"
mkdir -p \"\$d/state\"
d=\$(cd \"\$d\" && pwd)
rm -rf \"\$d/app.new\" \"\$d/app.old\"
mkdir \"\$d/app.new\"
$unpack -C \"\$d/app.new\"
sh \"\$d/app.new/setup.sh\" \"\$d/app\"
if [ -d \"\$d/app\" ]; then mv \"\$d/app\" \"\$d/app.old\"; fi
mv \"\$d/app.new\" \"\$d/app\"
rm -rf \"\$d/app.old\""
fi

exec ssh -t "${ssh_opts[@]}" "$@" "exec \"$remote_dir/app/enter\""

{{- /* Machine type: desktop, server or container. A value saved by an earlier
       init wins, so edit ~/.config/chezmoi/chezmoi.toml to override it. */ -}}
{{- $machine := "" -}}
{{- if hasKey . "machine" -}}
{{-   $machine = .machine -}}
{{- else if or (env "CODESPACES") (env "REMOTE_CONTAINERS") (stat "/.dockerenv") (stat "/run/.containerenv") -}}
{{-   $machine = "container" -}}
{{- else if lookPath "plasmashell" -}}
{{-   $machine = "desktop" -}}
{{- else if stdinIsATTY -}}
{{-   $machine = promptChoiceOnce . "machine" "Machine type" (list "desktop" "server" "container") -}}
{{- else -}}
{{-   $machine = "server" -}}
{{- end -}}

{{- $identity := joinPath .chezmoi.homeDir ".config/chezmoi/key.txt" -}}
{{- $hasSecrets := and (ne $machine "container") (stat $identity | not | not) -}}

{{- /* Where the Rust tools come from (scripts/install-apps.sh --build):
       prebuilt packages/releases, or cargo builds for this CPU. Asked once
       on interactive non-container inits; edit appsBuild to switch. */ -}}
{{- $appsBuild := "prebuilt" -}}
{{- if hasKey . "appsBuild" -}}
{{-   $appsBuild = .appsBuild -}}
{{- else if and (ne $machine "container") stdinIsATTY -}}
{{-   if promptBoolOnce . "appsBuildCargo" "Build the Rust tools with cargo, optimized for this CPU (slow: ~30 min)" false -}}
{{-     $appsBuild = "cargo" -}}
{{-   end -}}
{{- end -}}

sourceDir = {{ .chezmoi.workingTree | quote }}
encryption = "age"

[age]
    identity = {{ $identity | quote }}
    recipient = "age1ufuas7zez9ax6mululhrn7vwpz2x554f6dhxs3jtzk0en4kg6u6q58q8eu"
    useBuiltin = true

[data]
    machine = {{ $machine | quote }}
    hasSecrets = {{ $hasSecrets }}
    appsBuild = {{ $appsBuild | quote }}

[git]
    autoAdd = true
    autoCommit = true
    autoPush = false

[edit]
    apply = true
    watch = true

[diff]
    pager = "delta"